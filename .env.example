# Copy to .env and adjust as needed. All defaults match the original
# Kaggle notebook paths; overrides are optional and never change model
# behavior, only file locations.

WILDLIFE_DATASET_INPUT=/kaggle/input/datasets/banuprasadb/wildlife-dataset
WILDLIFE_DATASET_WORK=/kaggle/working
WILDLIFE_BLURRY_DATASET_DIR=/kaggle/working/wildlife-dataset-blurry
WILDLIFE_DATA_YAML=/kaggle/working/blurry_expert.yaml

PRECISION_MODEL_PATH=models/precision_expert/best.pt
KINETIC_MODEL_PATH=models/kinetic_expert/best.pt

WILDLIFE_RUNS_DIR=runs/wildlife_moe
